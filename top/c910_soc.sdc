}

# JTG_OUT: 2 port
set PORTS(JTG_OUT) {
  had_pad_jtg_tdo
  had_pad_jtg_tdo_en
}

# DEBUG_OUT: 14 port
set PORTS(DEBUG_OUT) {
  core0_pad_mstatus[*]
  core0_pad_retire0
  core0_pad_retire0_pc[*]
