}


################################################################################
# openC910.body.sdc -- constraint cho top openC910, cu phap SDC thuan (Genus/Innovus/Tempus)
#
# Chuyen the tu smart_run/impl/sdc/openC910.sdc + ct_top.sdc (T-Head, viet cho DC/PT).
# Thay doi so voi ban goc -- tung dong deu co ly do, xem README muc "SDC":
#   [1] Bo synopsys_program_name / get_flat_pins / echo / get_attribute / load_of:
#       la lenh Synopsys, Genus khong co hoac khac nghia.
#   [2] Generated clock dat len pin OUTPUT cua ICG cu the (ten tuong minh), vi RTL ban
#       FPGA dung BUFGCE; flow thay BUFGCE bang ICG ten x_gated_clk_cell.
#   [3] Port duoc liet ke tuong minh trong <top>.ports.sdc (khong wildcard,
#       khong dua vao ngu nghia "lenh sau ghi de lenh truoc").
#   [4] set_clock_groups -async ... -allow_path (chi PT) -> bo; giu y do bang
#       set_max_delay + false_path -hold giua CPU va JTG nhu ban goc.
#   [5] group_path -> chuyen sang cost group trong script Genus (khong de trong SDC).
#   [6] set_max_delay ... -ignore_clock_latency (PT) -> bo option nay.
#   [7] set_clock_uncertainty dat O CUOI, sau khi moi clock (ke ca generated) da ton tai.
#
# Bien PARAM(...) va PORTS(...) duoc dinh nghia o phan header/ports do flow ghep vao.
################################################################################

#------------------------------------------------------------------------------
# Design rule + moi truong I/O
#------------------------------------------------------------------------------
set_max_fanout     $PARAM(max_fanout)     [current_design]
set_max_transition $PARAM(max_transition) [current_design]
set_input_transition $PARAM(clk_input_transition) [get_ports $PORTS(CLK_PORTS)]

set _data_ins [concat $PORTS(DFT_STATIC_IN) $PORTS(PLIC_IN) $PORTS(JTG_IN) $PORTS(CPU_IN) \
                      $PORTS(RESET_IN) $PORTS(CONST_IN) $PORTS(SYS_IN)]
if {$PARAM(driving_pin) ne ""} {
  set_driving_cell -lib_cell $PARAM(driving_cell) -pin $PARAM(driving_pin) [get_ports $_data_ins]
} else {
  set_driving_cell -lib_cell $PARAM(driving_cell) [get_ports $_data_ins]
}
set_load $PARAM(output_load) [all_outputs]

#------------------------------------------------------------------------------
# Clock that + virtual clock
#------------------------------------------------------------------------------
set SYS_PERIOD  [expr {$PARAM(cpu_period) * $PARAM(sys2cpu_ratio)}]

create_clock -name CPU_CLK -period $PARAM(cpu_period) [get_ports pll_cpu_clk]
create_clock -name JTG_CLK -period $PARAM(jtg_period) [get_ports pad_had_jtg_tclk]

create_clock -name V_CPU_CLK -period $PARAM(cpu_period)
create_clock -name V_SYS_CLK -period $SYS_PERIOD
create_clock -name V_JTG_CLK -period $PARAM(jtg_period)

#------------------------------------------------------------------------------
# Generated clock tren output ICG (thay cho BUFGCE trong x_ct_mp_clk_top)
#   apb_clk_buf        : apb_clk_en_f lat moi chu ky -> clock /2, duty 25%  (edges 1 2 5)
#   data/tag_bankN_clk : clock SRAM L2 cho path multicycle
#------------------------------------------------------------------------------
set _icg_out "x_gated_clk_cell/$PARAM(icg_out_pin)"

create_generated_clock -name PLIC_CLK -source [get_ports pll_cpu_clk] -edges {1 2 5} \
   [get_pins x_ct_mp_clk_top/apb_clk_buf/$_icg_out]

set_multicycle_path -from [get_clocks CPU_CLK] -to [get_clocks PLIC_CLK] -setup 2 -start
set_multicycle_path -from [get_clocks CPU_CLK] -to [get_clocks PLIC_CLK] -hold  1 -start
set_multicycle_path -from [get_clocks PLIC_CLK] -to [get_clocks CPU_CLK] -setup 2 -end
set_multicycle_path -from [get_clocks PLIC_CLK] -to [get_clocks CPU_CLK] -hold  1 -end

proc _c910_mcp_edges {n} {
  switch -- $n {
    2 { return {1 2 5} }
    3 { return {1 2 7} }
    4 { return {1 2 9} }
    default { error "multicycle cho L2C chi ho tro 2/3/4, nhan duoc '$n'" }
  }
}

if {$PARAM(l2c_data_mcp) > 1} {
  set _e [_c910_mcp_edges $PARAM(l2c_data_mcp)]
  foreach i {0 1} {
    create_generated_clock -name L2C_DATA_MEM_CLOCK_$i -source [get_ports pll_cpu_clk] -edges $_e \
       [get_pins x_ct_mp_clk_top/data_bank${i}_clk_buf/$_icg_out]
  }
  set_multicycle_path -from [get_clocks {L2C_DATA_MEM_CLOCK_0 L2C_DATA_MEM_CLOCK_1}] -to [get_clocks CPU_CLK] \
     -setup $PARAM(l2c_data_mcp) -end
  set_multicycle_path -from [get_clocks {L2C_DATA_MEM_CLOCK_0 L2C_DATA_MEM_CLOCK_1}] -to [get_clocks CPU_CLK] \
     -hold [expr {$PARAM(l2c_data_mcp) - 1}] -end
}

if {$PARAM(l2c_tag_mcp) > 1} {
  set _e [_c910_mcp_edges $PARAM(l2c_tag_mcp)]
  foreach i {0 1} {
    create_generated_clock -name L2C_TAG_MEM_CLOCK_$i -source [get_ports pll_cpu_clk] -edges $_e \
       [get_pins x_ct_mp_clk_top/tag_bank${i}_clk_buf/$_icg_out]
  }
  set_multicycle_path -from [get_clocks {L2C_TAG_MEM_CLOCK_0 L2C_TAG_MEM_CLOCK_1}] -to [get_clocks CPU_CLK] \
     -setup $PARAM(l2c_tag_mcp) -end
  set_multicycle_path -from [get_clocks {L2C_TAG_MEM_CLOCK_0 L2C_TAG_MEM_CLOCK_1}] -to [get_clocks CPU_CLK] \
     -hold [expr {$PARAM(l2c_tag_mcp) - 1}] -end
}

#------------------------------------------------------------------------------
# SYS AXI clock = CPU / ratio  -> multicycle giua CPU_CLK va V_SYS_CLK
#------------------------------------------------------------------------------
if {$PARAM(sys2cpu_ratio) > 1} {
  set_multicycle_path -from [get_clocks CPU_CLK] -to [get_clocks V_SYS_CLK] -setup $PARAM(sys2cpu_ratio) -start
  set_multicycle_path -from [get_clocks CPU_CLK] -to [get_clocks V_SYS_CLK] -hold  [expr {$PARAM(sys2cpu_ratio) - 1}] -start
  set_multicycle_path -from [get_clocks V_SYS_CLK] -to [get_clocks CPU_CLK] -setup $PARAM(sys2cpu_ratio) -end
  set_multicycle_path -from [get_clocks V_SYS_CLK] -to [get_clocks CPU_CLK] -hold  [expr {$PARAM(sys2cpu_ratio) - 1}] -end
}

#------------------------------------------------------------------------------
# I/O delay theo nhom (moi port 1 nhom -- xem <top>.ports.sdc)
#------------------------------------------------------------------------------
# JTAG
set_input_delay  -max [expr {$PARAM(jtg_period)*0.4}] -clock V_JTG_CLK [get_ports $PORTS(JTG_IN)]
set_input_delay  -min 0                                -clock V_JTG_CLK [get_ports $PORTS(JTG_IN)]
set_output_delay -max [expr {$PARAM(jtg_period)*0.4}] -clock V_JTG_CLK [get_ports $PORTS(JTG_OUT)]
set_output_delay -min 0                                -clock V_JTG_CLK [get_ports $PORTS(JTG_OUT)]

# CPU-clock input
set_input_delay  -max [expr {$PARAM(cpu_period)*0.4}] -clock V_CPU_CLK [get_ports $PORTS(CPU_IN)]
set_input_delay  -min 0                                -clock V_CPU_CLK [get_ports $PORTS(CPU_IN)]

# SYS (AXI) -- ban goc cung dat delay nay cho reset va constant
set _sys_ins [concat $PORTS(SYS_IN) $PORTS(RESET_IN) $PORTS(CONST_IN)]
set_input_delay  -max [expr {$SYS_PERIOD*0.4}] -clock V_SYS_CLK [get_ports $_sys_ins]
set_input_delay  -min 0                         -clock V_SYS_CLK [get_ports $_sys_ins]
set_output_delay -max [expr {$SYS_PERIOD*0.6}] -clock V_SYS_CLK [get_ports $PORTS(SYS_OUT)]
set_output_delay -min 0                         -clock V_SYS_CLK [get_ports $PORTS(SYS_OUT)]

# Debug output: de floating o top, noi long bang output delay am (giu nhu ban goc)
set_output_delay -max [expr {$PARAM(cpu_period)*-2}] -clock V_CPU_CLK [get_ports $PORTS(DEBUG_OUT)]
set_output_delay -min 0                               -clock V_CPU_CLK [get_ports $PORTS(DEBUG_OUT)]

#------------------------------------------------------------------------------
# Exception o top
#------------------------------------------------------------------------------
# PLIC interrupt: async, chi gioi han do tre
set_max_delay $PARAM(async_max_delay) -from [get_ports $PORTS(PLIC_IN)]
set_false_path -hold                  -from [get_ports $PORTS(PLIC_IN)]

# Reset async + tin hieu tinh (hartid, rvba, apb_base, mbist ratio)
# pad_had_jtg_trst_b: ban goc vua thuoc JTG_INPUTS vua khop "*_rst_b" -> giu ca hai
set_max_delay $PARAM(async_max_delay) -from [get_ports [concat $PORTS(RESET_IN) pad_had_jtg_trst_b]]
set_max_delay $PARAM(async_max_delay) -from [get_ports $PORTS(CONST_IN)]

#------------------------------------------------------------------------------
# Exception trong moi core (ct_top.sdc voi parent_path = x_ct_top_N/)
#   Dung hierarchical pin -> flow dat auto_ungroup none de pin con ton tai.
#------------------------------------------------------------------------------
foreach _core {x_ct_top_0 x_ct_top_1} {
  # interrupt async tu PLIC/CLINT vao core
  set_max_delay [expr {$PARAM(cpu_period)*3}] -through [get_pins [list \
      $_core/pad_biu_me_int $_core/pad_biu_ms_int $_core/pad_biu_mt_int \
      $_core/pad_biu_se_int $_core/pad_biu_ss_int $_core/pad_biu_st_int]]
  # debug data/ctrl cat ngang CPU <-> JTAG
  foreach _p [list "$_core/ir_corex_wdata\[*\]" $_core/sm_update_dr $_core/sm_update_ir "$_core/x_regs_serial_data\[*\]"] {
    set_max_delay $PARAM(async_max_delay) -through [get_pins $_p]
    set_false_path -hold                  -through [get_pins $_p]
  }
  # tin hieu tinh + reset
  foreach _p [list "$_core/pad_core_hartid\[*\]" "$_core/pad_xx_apb_base\[*\]" "$_core/pad_core_rvba\[*\]" \
                   $_core/pad_core_rst_b $_core/pad_cpu_rst_b $_core/pad_yy_scan_rst_b] {
    set_max_delay $PARAM(async_max_delay) -through [get_pins $_p]
  }
}

#------------------------------------------------------------------------------
# CPU <-> JTAG: ban goc = clock_groups -async -allow_path + max_delay 10 + no hold
#------------------------------------------------------------------------------
set _cpu_clks [get_clocks {CPU_CLK V_SYS_CLK V_CPU_CLK}]
set _jtg_clks [get_clocks {JTG_CLK V_JTG_CLK}]
set_max_delay $PARAM(async_max_delay) -from $_cpu_clks -to $_jtg_clks
set_max_delay $PARAM(async_max_delay) -from $_jtg_clks -to $_cpu_clks
set_false_path -hold -from $_cpu_clks -to $_jtg_clks
set_false_path -hold -from $_jtg_clks -to $_cpu_clks

#------------------------------------------------------------------------------
# DFT: functional mode
#------------------------------------------------------------------------------
set_case_analysis 0 [get_ports pad_yy_scan_mode]
set_case_analysis 0 [get_ports pad_yy_icg_scan_en]
set_case_analysis 0 [get_ports pad_yy_scan_enable]
set_false_path -from [get_ports pad_yy_mbist_mode]

#------------------------------------------------------------------------------
# [7] Uncertainty: DAT CUOI. all_clocks chi tra ve clock da ton tai tai thoi diem goi.
#------------------------------------------------------------------------------
set_clock_uncertainty -setup $PARAM(setup_uncertainty) [all_clocks]
set_clock_uncertainty -hold  $PARAM(hold_uncertainty)  [all_clocks]

