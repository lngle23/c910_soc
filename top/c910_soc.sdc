  core1_pad_retire0_pc[*]
  core1_pad_retire1
  core1_pad_retire1_pc[*]
  core1_pad_retire2
  core1_pad_retire2_pc[*]
}

# SYS_OUT: 33 port
set PORTS(SYS_OUT) {
  biu_pad_araddr[*]
  biu_pad_arburst[*]
  biu_pad_arcache[*]
  biu_pad_arid[*]
  biu_pad_arlen[*]
  biu_pad_arlock
  biu_pad_arprot[*]
  biu_pad_arsize[*]
  biu_pad_arvalid
  biu_pad_awaddr[*]
  biu_pad_awburst[*]
  biu_pad_awcache[*]
  biu_pad_awid[*]
  biu_pad_awlen[*]
  biu_pad_awlock
  biu_pad_awprot[*]
