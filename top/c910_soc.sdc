# AUTO-GENERATED boi top (emit_top.py) -- spec v1.0. Doi gi thi sinh lai, khong sua tay.
# SDC CHIP (top = openC910). Giong SDC da dung o synthesis openC910 (2.5ns, AXI = CPU/2, L2C MCP 2).
################################################################################
# openC910.sdc -- AUTO-GENERATED by genus_c910 (2026-10-09 11:20)
# = header PARAM (tu config) + sdc/openC910.ports.sdc + sdc/openC910.body.sdc
# Don vi: ns, fF
################################################################################
set_units -time 1ns -capacitance 1fF   ;# (spec) gia tri trong file nay la ns / fF

set PARAM(cpu_period)            {2.5}
set PARAM(jtg_period)            {20.0}
set PARAM(sys2cpu_ratio)         {2}
set PARAM(l2c_data_mcp)          {2}
set PARAM(l2c_tag_mcp)           {2}
set PARAM(setup_uncertainty)     {0.10}
set PARAM(hold_uncertainty)      {0.05}
set PARAM(async_max_delay)       {10.0}
set PARAM(max_fanout)            {32}
set PARAM(max_transition)        {0.15}
set PARAM(clk_input_transition)  {0.05}
set PARAM(driving_cell)          {BUF_X2}
set PARAM(driving_pin)           {Z}
set PARAM(output_load)           {4.6}  ;# fF
set PARAM(icg_out_pin)           {GCK}

# AUTO-GENERATED by tools/gen_port_groups.py --top openC910 -- KHONG sua tay.
# 91 port, moi port thuoc dung 1 nhom. Bus ghi dang name[*].

# CLK_PORTS: 2 port
set PORTS(CLK_PORTS) {
  pad_had_jtg_tclk
  pll_cpu_clk
}

# DFT_STATIC_IN: 4 port
set PORTS(DFT_STATIC_IN) {
  pad_yy_icg_scan_en
  pad_yy_mbist_mode
  pad_yy_scan_enable
  pad_yy_scan_mode
}

# PLIC_IN: 2 port
set PORTS(PLIC_IN) {
  pad_plic_int_cfg[*]
  pad_plic_int_vld[*]
}

# JTG_IN: 3 port
set PORTS(JTG_IN) {
  pad_had_jtg_tdi
  pad_had_jtg_tms
  pad_had_jtg_trst_b
}

# CPU_IN: 1 port
set PORTS(CPU_IN) {
  axim_clk_en
}

# RESET_IN: 5 port
set PORTS(RESET_IN) {
  pad_core0_rst_b
  pad_core1_rst_b
  pad_cpu_rst_b
  pad_yy_dft_clk_rst_b
  pad_yy_scan_rst_b
}

# CONST_IN: 7 port
set PORTS(CONST_IN) {
  pad_core0_hartid[*]
  pad_core0_rvba[*]
  pad_core1_hartid[*]
  pad_core1_rvba[*]
  pad_cpu_apb_base[*]
  pad_l2c_data_mbist_clk_ratio[*]
  pad_l2c_tag_mbist_clk_ratio[*]
}

# SYS_IN: 18 port
set PORTS(SYS_IN) {
  pad_biu_arready
  pad_biu_awready
  pad_biu_bid[*]
  pad_biu_bresp[*]
  pad_biu_bvalid
  pad_biu_csysreq
  pad_biu_rdata[*]
