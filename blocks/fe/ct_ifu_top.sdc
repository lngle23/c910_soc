# AUTO-GENERATED boi top (emit_spec.py) tu ket noi RTL da elaborate -- KHONG sua tay.
# Muon doi: bao nguoi lam top, top sinh lai va phat hanh version moi.

# SDC block ct_ifu_top -- ngan sach timing tu top (v1.0). Don vi: ns, fF (= don vi lib Nangate45).
# Khong co set_units: Genus va Innovus deu hieu theo don vi thu vien.
# Chu ky CPU_CLK = 2.5 ns. Ngan sach port giua 2 block: moi block 50% chu ky, day top nam trong phan 10% du cua ben nhan.
set_units -time 1ns -capacitance 1fF   ;# gia tri ben duoi la ns / fF (Genus doc set_units; Innovus dung don vi lib = ns/fF, cung ket qua)
set_max_fanout 32 [current_design]
set_max_transition 0.15 [current_design]
create_clock -name CPU_CLK -period 2.5 [get_ports forever_cpuclk]
create_clock -name V_CPU_CLK -period 2.5
set_input_transition 0.05 [get_ports {forever_cpuclk}]
# Clock ao (IO) va clock that (truoc CTS) cung co do tre = muc tieu insertion delay cua block (0.35 ns).
# Sau CTS (set_propagated_clock / ccopt) do tre that thay cho gia tri ly tuong cua clock that; clock ao giu nguyen.
set_clock_latency 0.35 [get_clocks V_CPU_CLK]
set_clock_latency 0.35 [get_clocks CPU_CLK]
set_driving_cell -lib_cell BUF_X2 -pin Z [get_ports {biu_ifu_rd_data[*] biu_ifu_rd_data_vld biu_ifu_rd_grnt biu_ifu_rd_id biu_ifu_rd_last biu_ifu_rd_resp[*] cp0_idu_cskyee cp0_idu_frm[*] cp0_idu_fs[*] cp0_ifu_bht_en cp0_ifu_bht_inv cp0_ifu_btb_en cp0_ifu_btb_inv cp0_ifu_icache_en cp0_ifu_icache_inv cp0_ifu_icache_pref_en cp0_ifu_icache_read_index[*] cp0_ifu_icache_read_req cp0_ifu_icache_read_tag cp0_ifu_icache_read_way cp0_ifu_icg_en cp0_ifu_ind_btb_en cp0_ifu_ind_btb_inv cp0_ifu_insde cp0_ifu_iwpe cp0_ifu_l0btb_en cp0_ifu_lbuf_en cp0_ifu_no_op_req cp0_ifu_nsfe cp0_ifu_ras_en cp0_ifu_rst_inv_done cp0_ifu_rvbr[*] cp0_ifu_vbr[*] cp0_ifu_vl[*] cp0_ifu_vlmul[*] cp0_ifu_vsetvli_pred_disable cp0_ifu_vsetvli_pred_mode cp0_ifu_vsew[*] cp0_yy_clk_en cp0_yy_priv_mode[*] cpurst_b had_ifu_ir[*] had_ifu_ir_vld had_ifu_pc[*] had_ifu_pcload had_rtu_xx_jdbreq had_yy_xx_bkpta_base[*] had_yy_xx_bkpta_mask[*] had_yy_xx_bkpta_rc had_yy_xx_bkptb_base[*] had_yy_xx_bkptb_mask[*] had_yy_xx_bkptb_rc hpcp_ifu_cnt_en idu_ifu_id_bypass_stall idu_ifu_id_stall iu_ifu_bht_check_vld iu_ifu_bht_condbr_taken iu_ifu_bht_pred iu_ifu_chgflw_pc[*] iu_ifu_chgflw_vl[*] iu_ifu_chgflw_vld iu_ifu_chgflw_vlmul[*] iu_ifu_chgflw_vsew[*] iu_ifu_chk_idx[*] iu_ifu_cur_pc[*] iu_ifu_mispred_stall iu_ifu_pcfifo_full lsu_ifu_icache_all_inv lsu_ifu_icache_index[*] lsu_ifu_icache_line_inv lsu_ifu_icache_ptag[*] mmu_ifu_buf mmu_ifu_ca mmu_ifu_deny mmu_ifu_pa[*] mmu_ifu_pavld mmu_ifu_pgflt mmu_ifu_sec mmu_xx_mmu_en pad_yy_icg_scan_en rtu_ifu_chgflw_pc[*] rtu_ifu_chgflw_vld rtu_ifu_flush rtu_ifu_retire0_chk_idx[*] rtu_ifu_retire0_condbr rtu_ifu_retire0_condbr_taken rtu_ifu_retire0_inc_pc[*] rtu_ifu_retire0_jmp rtu_ifu_retire0_jmp_mispred rtu_ifu_retire0_mispred rtu_ifu_retire0_next_pc[*] rtu_ifu_retire0_pcall rtu_ifu_retire0_preturn rtu_ifu_retire1_chk_idx[*] rtu_ifu_retire1_condbr rtu_ifu_retire1_condbr_taken rtu_ifu_retire1_jmp rtu_ifu_retire2_chk_idx[*] rtu_ifu_retire2_condbr rtu_ifu_retire2_condbr_taken rtu_ifu_retire