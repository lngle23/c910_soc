# AUTO-GENERATED boi top (emit_spec.py) tu ket noi RTL da elaborate -- KHONG sua tay.
# Muon doi: bao nguoi lam top, top sinh lai va phat hanh version moi.

# SDC block ct_l2c_top -- ngan sach timing tu top (v1.0). Don vi: ns, fF (= don vi lib Nangate45).
# Khong co set_units: Genus va Innovus deu hieu theo don vi thu vien.
# Chu ky CPU_CLK = 2.5 ns. Ngan sach port giua 2 block: moi block 50% chu ky, day top nam trong phan 10% du cua ben nhan.
set_units -time 1ns -capacitance 1fF   ;# gia tri ben duoi la ns / fF (Genus doc set_units; Innovus dung don vi lib = ns/fF, cung ket qua)
set_max_fanout 32 [current_design]
set_max_transition 0.15 [current_design]
create_clock -name CPU_CLK -period 2.5 [get_ports forever_cpuclk]
create_clock -name V_CPU_CLK -period 2.5
set_input_transition 0.05 [get_ports {forever_cpuclk l2c_data_clk_bank_0 l2c_data_clk_bank_1 l2c_tag_clk_bank_0 l2c_tag_clk_bank_1}]
# Clock ao (IO) va clock that (truoc CTS) cung co do tre = muc tieu insertion delay cua block (0.4 ns).
# Sau CTS (set_propagated_clock / ccopt) do tre that thay cho gia tri ly tuong cua clock that; clock ao giu nguyen.
set_clock_latency 0.4 [get_clocks V_CPU_CLK]
set_clock_latency 0.4 [get_clocks CPU_CLK]
create_clock -name L2C_DATA_MEM_CLOCK_0 -period 5.0 -waveform {0 1.25} [get_ports l2c_data_clk_bank_0]
create_clock -name L2C_DATA_MEM_CLOCK_1 -period 5.0 -waveform {0 1.25} [get_ports l2c_data_clk_bank_1]
set_multicycle_path -from [get_clocks {L2C_DATA_MEM_CLOCK_0 L2C_DATA_MEM_CLOCK_1}] -to [get_clocks CPU_CLK] -setup 2 -end
set_multicycle_path -from [get_clocks {L2C_DATA_MEM_CLOCK_0 L2C_DATA_MEM_CLOCK_1}] -to [get_clocks CPU_CLK] -hold 1 -end
create_clock -name L2C_TAG_MEM_CLOCK_0 -period 5.0 -waveform {0 1.25} [get_ports l2c_tag_clk_bank_0]
create_clock -name L2C_TAG_MEM_CLOCK_1 -period 5.0 -waveform {0 1.25} [get_ports l2c_tag_clk_bank_1]
set_multicycle_path -from [get_clocks {L2C_TAG_MEM_CLOCK_0 L2C_TAG_MEM_CLOCK_1}] -to [get_clocks CPU_CLK] -setup 2 -end
set_multicycle_path -from [get_clocks {L2C_TAG_MEM_CLOCK_0 L2C_TAG_MEM_CLOCK_1}] -to [get_clocks CPU_CLK] -hold 1 -end
# Clock bo nho duoc gate o top (x_ct_mp_clk_top), cung pha voi CPU_CLK -> cung nhom dong bo
set_clock_latency 0.4 [get_clocks {L2C_DATA_MEM_CLOCK_0 L2C_DATA_MEM_CLOCK_1 L2C_TAG_MEM_CLOCK_0 L2C_TAG_MEM_CLOCK_1}]
set_driving_cell -lib_cell BUF_X2 -pin Z [get_ports {ciu_l2c_addr_bank_0[*] ciu_l2c_addr_bank_1[*] ciu_l2c_addr_vld_bank_0 ciu_l2c_addr_vld_bank_1 ciu_l2c_clr_cp_bank_0[*] ciu_l2c_clr_cp_bank_1[*] ciu_l2c_ctcq_req_bank_0 ciu_l2c_ctcq_req_bank_1 ciu_l2c_data_latency[*] ciu_l2c_data_setup ciu_l2c_data_vld_bank_0 ciu_l2c_data_vld_bank_1 ciu_l2c_dca_addr_bank_0[*] ciu_l2c_dca_addr_bank_1[*] ciu_l2c_dca_req_bank_0 ciu_l2c_dca_req_bank_1 ciu_l2c_hpcp_bus_bank_0[*] ciu_l2c_hpcp_bus_bank_1[*] ciu_l2c_icc_mid_bank_0[*] ciu_l2c_icc_mid_bank_1[*] ciu_l2c_icc_type_bank_0[*] ciu_l2c_icc_type_bank_1[*] ciu_l2c_iprf[*] ciu_l2c_mid_bank_0[*] ciu_l2c_mid_bank_1[*] ciu_l2c_prf_ready ciu_l2c_rdl_ready_bank_0 ciu_l2c_rdl_ready_bank_1 ciu_l2c_rst_req ciu_l2c_set_cp_bank_0[*] ciu_l2c_set_cp_bank_1[*] ciu_l2c_sid_bank_0[*] ciu_l2c_sid_bank_1[*] ciu_l2c_snpl2_ready_bank_0 ciu_l2c_snpl2_ready_bank_1 ciu_l2c_src_bank_0[*] ciu_l2c_src_bank_1[*] ciu_l2c_tag_latency[*] ciu_l2c_tag_setup ciu_l2c_tprf ciu_l2c_type_bank_0[*] ciu_l2c_type_bank_1[*] ciu_l2c_wdata_bank_0[*] ciu_l2c_wdata_bank_1[*] ciu_top_clk ciu_xx_no_op cpurst_b l2c_icg_en pad_yy_icg_scan_en sysio_l2c_flush_req}]
set_load 5.0 [get_ports {l2c_ciu_addr_ready_bank_0 l2c_ciu_addr_ready_bank_1 l2c_ciu_cmplt_bank_0 l2c_ciu_cmplt_bank_1 l2c_ciu_cp_bank_0[*] l2c_ciu_cp_bank_1[*] l2c_ciu_ctcq_cmplt_bank_0 l2c_ciu_ctcq_cmplt_bank_1 l2c_ciu_ctcq_ready_bank_0 l2c_ciu_ctcq_ready_bank_1 l2c_ciu_data_bank_0[*] l2c_ciu_data_bank_1[*] l2c_ciu_data_ready_bank_0 l2c_ciu_data_ready_bank_1 l2c_ciu_data_ready_gate_bank_0 l2c_ciu_data_ready_gate_bank_1 l2c_ciu_dbg_info[*] l2c_ciu_dca_cmplt_bank_0 l2c_ciu_dca_cmplt_bank_1 l2c_ciu_dca_data_bank_0[*] l2c_ciu_dca_data_bank_1[*] l2c_ciu_dca_ready_bank_0 l2c_ciu_dca_ready_bank_1 l2c_ciu_hpcp_acc_inc_bank_0[*] l2c_ciu_hpcp_acc_inc_bank_1[*] l2c_ciu_hpcp_mid_bank_0[*] l2c_ciu_hpcp_mid_bank_1[*] l2c_ciu_hpcp_miss_inc_bank_0[*] l2c_ciu_hpcp_miss_inc_bank_1[*] l2c_ciu_prf_addr[*] l2c_ciu_prf_prot[*] l2c_ciu_prf_vld l2c_ciu_rdl_addr_bank_0[*] l2c_ciu_rdl_addr_bank_1[*] l2c_ciu_rdl_dvld_bank_0 l2c_ciu_rdl_dvld_bank_1 l2c_ciu_rdl_mid_bank_0[*] l2c_ciu_rdl_mid_bank_1[*] l2c_ciu_rdl_prot_bank_0[*] l2c_ciu_rdl_prot_bank_1[*] l2c_ciu_rdl_rvld_bank_0 l2c_ciu_rdl_rvld_bank_1 l2c_ciu_resp_bank_0[*] l2c_ciu_resp_bank_1[*] l2c_ciu_sid_bank_0[*] l2c_ciu_sid_bank_1[*] l2c_ciu_snpl2_addr_bank_0[*] l2c_ciu_snpl2_addr_bank_1[*] l2c_ciu_snpl2_ini_sid_bank_0[*] l2c_ciu_snpl2_ini_sid_bank_1[*] l2c_ciu_snpl2_vld_bank_0 l2c_ciu_snpl2_vld_bank_1 l2c_xx_no_op}]   ;# fF, pin doi dien block ben canh
set_load 10.0 [get_ports {l2c_data_ram_clk_en_bank_0 l2c_data_ram_clk_en_bank_1 l2c_sysio_flush_done l2c_sysio_flush_idle l2c_tag_ram_clk_en_bank_0 l2c_tag_ram_clk_en_bank_1}]  ;# fF, di xa hon trong top
# async/tinh: 1 bit -- max_delay 10.0 ns nhu SDC goc, khong kiem hold
set_input_delay 0 -clock V_CPU_CLK [get_ports {cpurst_b}]
set_max_delay 10.0 -from [get_ports {cpurst_b}]
set_false_path -hold -from [get_ports {cpurst_b}]
# bb: 1261 bit in
set_input_delay -max 1.25 -clock V_CPU_CLK [get_ports {ciu_l2c_addr_bank_0[*] ciu_l2c_addr_bank_1[*] ciu_l2c_addr_vld_bank_0 ciu_l2c_addr_vld_bank_1 ciu_l2c_clr_cp_bank_0[*] ciu_l2c_clr_cp_bank_1[*] ciu_l2c_ctcq_req_bank_0 ciu_l2c_ctcq_req_bank_1 ciu_l2c_data_latency[*] ciu_l2c_data_setup ciu_l2c_data_vld_bank_0 ciu_l2c_data_vld_bank_1 ciu_l2c_dca_addr_bank_0[*] ciu_l2c_dca_addr_bank_1[*] ciu_l2c_dca_req_bank_0 ciu_l2c_dca_req_bank_1 ciu_l2c_hpcp_bus_bank_0[*] ciu_l2c_hpcp_bus_bank_1[*] ciu_l2c_icc_mid_bank_0[*] ciu_l2c_icc_mid_bank_1[*] ciu_l2c_icc_type_bank_0[*] ciu_l2c_icc_type_bank_1[*] ciu_l2c_iprf[*] ciu_l2c_mid_bank_0[*] ciu_l2c_mid_bank_1[*] ciu_l2c_prf_ready ciu_l2c_rdl_ready_bank_0 ciu_l2c_rdl_ready_bank_1 ciu_l2c_rst_req ciu_l2c_set_cp_bank_0[*] ciu_l2c_set_cp_bank_1[*] ciu_l2c_sid_bank_0[*] ciu_l2c_sid_bank_1[*] ciu_l2c_snpl2_ready_bank_0 ciu_l2c_snpl2_ready_bank_1 ciu_l2c_src_bank_0[*] ciu_l2c_src_bank_1[*] ciu_l2c_tag_latency[*] ciu_l2c_tag_setup ciu_l2c_tprf ciu_l2c_type_bank_0[*] ciu_l2c_type_bank_1[*] ciu_l2c_wdata_bank_0[*] ciu_l2c_wdata_bank_1[*] ciu_top_clk l2c_icg_en}]
set_input_delay -min 0 -clock V_CPU_CLK [get_ports {ciu_l2c_addr_bank_0[*] ciu_l2c_addr_bank_1[*] ciu_l2c_addr_vld_bank_0 ciu_l2c_addr_vld_bank_1 ciu_l2c_clr_cp_bank_0[*] ciu_l2c_clr_cp_bank_1[*] ciu_l2c_ctcq_req_bank_0 ciu_l2c_ctcq_req_bank_1 ciu_l2c_data_latency[*] ciu_l2c_data_setup ciu_l2c_data_vld_bank_0 ciu_l2c_data_vld_bank_1 ciu_l2c_dca_addr_bank_0[*] ciu_l2c_dca_addr_bank_1[*] ciu_l2c_dca_req_bank_0 ciu_l2c_dca_req_bank_1 ciu_l2c_hpcp_bus_bank_0[*] ciu_l2c_hpcp_bus_bank_1[*] ciu_l2c_icc_mid_bank_0[*] ciu_l2c_icc_mid_bank_1[*] ciu_l2c_icc_type_bank_0[*] ciu_l2c_icc_type_bank_1[*] ciu_l2c_iprf[*] ciu_l2c_mid_bank_0[*] ciu_l2c_mid_bank_1[*] ciu_l2c_prf_ready ciu_l2c_rdl_ready_bank_0 ciu_l2c_rdl_ready_bank_1 ciu_l2c_rst_req ciu_l2c_set_cp_bank_0[*] ciu_l2c_set_cp_bank_1[*] ciu_l2c_sid_bank_0[*] ciu_l2c_sid_bank_1[*] ciu_l2c_snpl2_ready_bank_0 ciu_l2c_snpl2_ready_bank_1 ciu_l2c_src_bank_0[*] ciu_l2c_src_bank_1[*] ciu_l2c_tag_latency[*] ciu_l2c_tag_setup ciu_l2c_tprf ciu_l2c_type_bank_0[*] ciu_l2c_type_bank_1[*] ciu_l2c_wdata_bank_0[*] ciu_l2c_wdata_bank_1[*] ciu_top_clk l2c_icg_en}]
# bb: 1581 bit out
set_output_delay -max 1.25 -clock V_CPU_CLK [get_ports {l2c_ciu_addr_ready_bank_0 l2c_ciu_addr_ready_bank_1 l2c_ciu_cmplt_bank_0 l2c_ciu_cmplt_bank_1 l2c_ciu_cp_bank_0[*] l2c_ciu_cp_bank_1[*] l2c_ciu_ctcq_cmplt_bank_0 l2c_ciu_ctcq_cmplt_bank_1 l2c_ciu_ctcq_ready_bank_0 l2c_ciu_ctcq_ready_bank_1 l2c_ciu_data_bank_0[*] l2c_ciu_data_bank_1[*] l2c_ciu_data_ready_bank_0 l2c_ciu_data_ready_bank_1 l2c_ciu_data_ready_gate_bank_0 l2c_ciu_data_ready_gate_bank_1 l2c_ciu_dbg_info[*] l2c_ciu_dca_cmplt_bank_0 l2c_ciu_dca_cmplt_bank_1 l2c_ciu_dca_data_bank_0[*] l2c_ciu_dca_data_bank_1[*] l2c_ciu_dca_ready_bank_0 l2c_ciu_dca_ready_bank_1 l2c_ciu_hpcp_acc_inc_bank_0[*] l2c_ciu_hpcp_acc_inc_bank_1[*] l2c_ciu_hpcp_mid_bank_0[*] l2c_ciu_hpcp_mid_bank_1[*] l2c_ciu_hpcp_miss_inc_bank_0[*] l2c_ciu_hpcp_miss_inc_bank_1[*] l2c_ciu_prf_addr[*] l2c_ciu_prf_prot[*] l2c_ciu_prf_vld l2c_ciu_rdl_addr_bank_0[*] l2c_ciu_rdl_addr_bank_1[*] l2c_ciu_rdl_dvld_bank_0 l2c_ciu_rdl_dvld_bank_1 l2c_ciu_rdl_mid_bank_0[*] l2c_ciu_rdl_mid_bank_1[*] l2c_ciu_rdl_prot_bank_0[*] l2c_ciu_rdl_prot_bank_1[*] l2c_ciu_rdl_rvld_bank_0 l2c_ciu_rdl_rvld_bank_1 l2c_ciu_resp_bank_0[*] l2c_ciu_resp_bank_1[*] l2c_ciu_sid_bank_0[*] l2c_ciu_sid_bank_1[*] l2c_ciu_snpl2_addr_bank_0[*] l2c_ciu_snpl2_addr_bank_1[*] l2c_ciu_snpl2_ini_sid_bank_0[*] l2c_ciu_snpl2_ini_sid_bank_1[*] l2c_ciu_snpl2_vld_bank_0 l2c_ciu_snpl2_vld_bank_1 l2c_xx_no_op}]
